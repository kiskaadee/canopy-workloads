# Gitea Actions Runner environment variables (injected at runtime; never commit real tokens)
GITEA_INSTANCE_URL=http://gitea:3000
GITEA_RUNNER_TOKEN=replace-with-gitea-runner-registration-token
GITEA_RUNNER_NAME=homelab-runner
GITEA_RUNNER_LABELS=ubuntu-latest:host,nix:host

# Host state root (default: ~/var/lib/homelab; compose mounts ~/var/lib/homelab/gitea_runner:/data)
HOMELAB_STATE_ROOT=~/var/lib/homelab
