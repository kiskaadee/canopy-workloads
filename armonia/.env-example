# --- Required Build & Image Resolution ---
# Upstream Git repository URL for building armonia-dashboard (required for compose_build)
DASHBOARD_REPO_URL=https://git.example.com/org/armonia-dashboard.git
DASHBOARD_REF=main
# Pre-built container image reference for armonia-api
ARMONIA_API_IMAGE=homelab-armonia-armonia-api:latest

# --- Runtime & Database ---
ENVIRONMENT=production
APP_ENV=production
AUTH_PROVIDER=proxy_headers
DATABASE_URL=file:/data/armonia.db
DATABASE_AUTH_TOKEN=

# --- Domain & Proxy Configuration (injected by host runtime / appctl) ---
SERVICE_DOMAIN=armonia.example.com
PROXY_NETWORK=proxy-net
HTTP_ENTRYPOINT=web
HTTPS_ENTRYPOINT=websecure
CERT_RESOLVER=myresolver
AUTH_MIDDLEWARE=authelia-auth@docker
HTTPS_REDIRECT_MIDDLEWARE=https-redirect@docker

# --- User/Group IDs ---
PUID=1001
PGID=988

# --- Application Settings ---
THERAPIST_NAME=
BUSINESS_NAME=Armonía del Ser
WHATSAPP_PHONE=
SPEI_CLABE=
SPEI_BANK=
SPEI_BENEFICIARY=
GCAL_CALENDAR_ID=primary
GOOGLE_SERVICE_ACCOUNT_JSON=
